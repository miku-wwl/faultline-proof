# Nonexecuting template. Do not put real credentials here or in tracked files.
# Inject real values into the trusted host/service only, after authorization.
# Cloud-management credentials and inference credentials are separate.
VULTR_API_KEY=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Exact model is selected only after catalog and live feature qualification.
VULTR_INFERENCE_MODEL=
# Private deployment values remain unset until explicit provisioning.
FAULTLINE_PUBLIC_HOST=
FAULTLINE_PRIVATE_STATE_DIR=
# AIG capability/scope are deliberately absent: provision privately at kickoff.
